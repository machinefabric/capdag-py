# The package builds the program generated from the proved model in ../formal (src/capdag/_formal,
# see ../lungo.toml) with CMake, on lungo-py — at exactly the lungo release that generated it. The
# model's URNs are tagged-urn's, so tagged-urn is pinned exactly too: its model must have the layout
# this program was generated against, which the module checks when it is imported.
{%- if env.MFR_LOCAL_LIBS %}
# MFR_LOCAL_LIBS: lungo-py and tagged-urn at the working copies' versions. lungo-py's wheel is in
# lungo's local distribution (pip --find-links <build root>/lungo/distribution/wheels); tagged-urn is
# the working copy, installed with this package. Re-render without it before committing or releasing.
{%- endif %}
[build-system]
requires = ["scikit-build-core>=0.10", "lungo-py=={{ projects.lungo.version }}"]
build-backend = "scikit_build_core.build"

[project]
name = "capdag"
version = "{{ project.version }}"
description = "Core capability URN and definition system for CapDAG"
readme = "README.md"
authors = [{name = "https://github.com/machinefabric"}]
license = "MIT"
requires-python = ">=3.11"
dependencies = [
	"opsx-py>=1.21.119",
    "lungo-py=={{ projects.lungo.version }}",
    "tagged-urn=={% if env.MFR_LOCAL_LIBS %}{{ projects.tagged_urn_py.version }}{% else %}{{ projects.tagged_urn_py.latest_remote_version }}{% endif %}",
    "cbor2>=5.4.0",
	"python-pest>=0.1.1",
    # The fabric registry is an HTTP client; the CLI has no offline-only mode.
    "httpx>=0.24",
]

[project.scripts]
# The Python mirror's CLI. `capdag new` is how a cartridge project comes into
# existence, and every mirror creates the same project — so every mirror ships
# the command.
capdag = "capdag.cli:main"

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
    "pytest-cov>=4.0",
]

[tool.scikit-build]
minimum-version = "build-system.requires"
wheel.packages = ["src/capdag"]

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_functions = ["test_*"]
